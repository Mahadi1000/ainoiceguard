{
  "name": "ainoiceguard",
  "version": "0.2.0",
  "description": "Real-time noise cancellation desktop app (Krisp-inspired)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:native": "powershell -ExecutionPolicy Bypass -File ./scripts/build-native.ps1",
    "build:native:unix": "bash ./scripts/build-native-linux.sh",
    "rebuild:electron": "electron-rebuild -f -w ainoiceguard",
    "dist": "npm run dist:all",
    "dist:win": "powershell -ExecutionPolicy Bypass -File ./scripts/dist-win.ps1",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz --x64 --publish never --config.directories.output=dist/linux",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never --config.directories.output=dist/mac",
    "dist:all": "node ./scripts/dist-all.js",
    "dist:full": "npm run build:native && npm run rebuild:electron && npm run dist:win",
    "dist:full:unix": "npm run build:native:unix && npm run rebuild:electron && npm run dist:linux",
    "dist:full:mac": "npm run build:native:unix && npm run rebuild:electron && npm run dist:mac",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:ci": "npm run test",
    "check:package": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8')); console.log('package.json OK')\"",
    "verify:dist:win": "node scripts/verify-dist.js dist/win",
    "verify:dist:linux": "node scripts/verify-dist.js dist/linux",
    "verify:dist:mac": "node scripts/verify-dist.js dist/mac"
  },
  "keywords": [
    "noise-cancellation",
    "rnnoise",
    "electron",
    "portaudio",
    "wasapi"
  ],
  "author": {
    "name": "Mahadi Hasan",
    "email": "138366726+Mahadi1000@users.noreply.github.com",
    "url": "https://github.com/Mahadi1000"
  },
  "homepage": "https://github.com/Mahadi1000/ainoiceguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mahadi1000/ainoiceguard.git"
  },
  "bugs": {
    "url": "https://github.com/Mahadi1000/ainoiceguard/issues"
  },
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "^12.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.ainoiceguard.app",
    "productName": "Ainoiceguard",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "build/Release/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "build/Release/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "electron/assets/icon.ico"
    },
    "linux": {
      "category": "Audio",
      "maintainer": "Mahadi Hasan <138366726+Mahadi1000@users.noreply.github.com>",
      "synopsis": "Real-time noise cancellation for your microphone",
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ainoiceguard",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "uninstallDisplayName": "Ainoiceguard",
      "include": "build/installer/installer.nsh"
    },
    "copyright": "Copyright © 2026 Mahadi Hasan and Ainoiceguard contributors"
  }
}
